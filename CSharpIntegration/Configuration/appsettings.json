{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "SalesForecasting": "Debug"
    }
  },
  "Forecasting": {
    "PythonScriptPath": "../Scripts/python_prediction_bridge.py",
    "DataDirectory": "../../../data",
    "PythonExecutable": "python",
    "PythonTimeoutSeconds": 60,
    "UseHybridModels": true,
    "EnableFallback": true,
    "MinimumDataPoints": 7,
    "DefaultHorizonDays": 30,
    "DefaultConfidenceLevel": 0.90
  }
}
